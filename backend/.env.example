# ---- Analysis brain (role #1) model provider keys ----
# Claude is the default brain. Set at least this one.
ANTHROPIC_API_KEY=

# Optional additional providers for the model picker:
OPENAI_API_KEY=
GEMINI_API_KEY=
# Qwen / Kimi (and others) are routed via OpenRouter by default:
OPENROUTER_API_KEY=

# Default analysis-brain model (must be a key in app/core/models.py MODEL_REGISTRY)
DEFAULT_MODEL=claude-default

# ---- Live-query mode (role #2 real engines) ----
PERPLEXITY_API_KEY=
SERPAPI_API_KEY=

# ---- Peec AI mode ----
PEEC_API_KEY=
PEEC_BASE_URL=https://api.peec.ai

# ---- App settings ----
KNOWLEDGE_BASE_DIR=../Knowledge_base
DATABASE_URL=sqlite+aiosqlite:///./geo_assistant.db
# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:3000
# Set to "true" to use the headless browser render path during URL fetch
ENABLE_PLAYWRIGHT=true
